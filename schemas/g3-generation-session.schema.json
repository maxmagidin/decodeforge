{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decodeforge:schema:g3-generation-session-v1",
  "title": "DecodeForge G3 generation session V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "format",
    "canonical_identity_algorithm",
    "session_id",
    "session_index",
    "experiment_spec",
    "bundle_inventory",
    "state",
    "prompt",
    "provenance",
    "environment",
    "assets",
    "offline_preparation",
    "startup_timings",
    "runs",
    "correctness",
    "reconciliation",
    "drift"
  ],
  "properties": {
    "schema_version": {
      "$ref": "urn:decodeforge:schema:common-v1#/$defs/schema_version"
    },
    "protocol_id": {"const": "g3-tinyllama-qproj-generation-v1"},
    "format": {"const": "decodeforge_g3_generation_session_v1"},
    "canonical_identity_algorithm": {
      "const": "sha256_utf8_json_sort_keys_compact_unicode_no_nan_v1"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "session_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "experiment_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "benchmarks/g3/spec.json"},
        "sha256": {
          "const": "3d4a5d8662cc8d8b41814d2a72d614349afc8e93c78d587489b28c82f290dd2f"
        }
      }
    },
    "bundle_inventory": {"$ref": "#/$defs/bundle_inventory"},
    "state": {"$ref": "#/$defs/state"},
    "prompt": {"$ref": "#/$defs/prompt"},
    "provenance": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/provenance"}]},
    "environment": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/environment"}]},
    "assets": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/assets"}]},
    "offline_preparation": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/offline_preparation"}]
    },
    "startup_timings": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/startup_timings"}]
    },
    "runs": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/runs"}]},
    "correctness": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/correctness"}]
    },
    "reconciliation": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/reconciliation"}]
    },
    "drift": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/drift"}]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "properties": {"status": {"const": "not_run"}},
            "required": ["status"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "session_index": {"const": 0},
          "state": {
            "properties": {
              "stage": {"const": "not_run"},
              "accepted": {"const": false},
              "rejection_reasons": {"const": ["not_run"]}
            }
          },
          "provenance": {"type": "null"},
          "environment": {"type": "null"},
          "assets": {"type": "null"},
          "offline_preparation": {"type": "null"},
          "startup_timings": {"type": "null"},
          "runs": {"type": "null"},
          "correctness": {"type": "null"},
          "reconciliation": {"type": "null"},
          "drift": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "properties": {"status": {"const": "accepted"}},
            "required": ["status"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "stage": {"const": "completed"},
              "accepted": {"const": true},
              "rejection_reasons": {"const": []}
            }
          },
          "provenance": {"$ref": "#/$defs/provenance"},
          "environment": {"$ref": "#/$defs/environment"},
          "assets": {"$ref": "#/$defs/assets"},
          "offline_preparation": {"$ref": "#/$defs/offline_preparation"},
          "startup_timings": {"$ref": "#/$defs/startup_timings"},
          "runs": {"$ref": "#/$defs/runs"},
          "correctness": {"$ref": "#/$defs/correctness"},
          "reconciliation": {"$ref": "#/$defs/reconciliation"},
          "drift": {"$ref": "#/$defs/drift"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "properties": {"status": {"const": "rejected"}},
            "required": ["status"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "stage": {
                "enum": ["preflight", "warmup", "measurement", "finalization"]
              },
              "accepted": {"const": false},
              "rejection_reasons": {
                "minItems": 1,
                "not": {"contains": {"const": "not_run"}}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "$ref": "urn:decodeforge:schema:common-v1#/$defs/bundle_id"
    },
    "bundle_inventory": {
      "type": "array",
      "const": [
        {"path": "README.md", "role": "human_summary"},
        {"path": "analysis.json", "role": "derived_analysis"},
        {"path": "asset-inventory.json", "role": "asset_provenance"},
        {"path": "correctness.json", "role": "correctness_evidence"},
        {"path": "coverage.json", "role": "dispatch_coverage"},
        {"path": "environment.txt", "role": "environment_capture"},
        {"path": "generated.txt", "role": "demonstration_text"},
        {"path": "manifest.json", "role": "closed_bundle_manifest"},
        {"path": "prompt.json", "role": "prompt_and_token_ids"},
        {"path": "timings.csv", "role": "raw_timing_samples"}
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stage", "accepted", "rejection_reasons"],
      "properties": {
        "status": {"enum": ["not_run", "accepted", "rejected"]},
        "stage": {
          "enum": [
            "not_run",
            "preflight",
            "warmup",
            "measurement",
            "finalization",
            "completed"
          ]
        },
        "accepted": {"type": "boolean"},
        "rejection_reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 15,
          "items": {
            "enum": [
              "not_run",
              "environment_mismatch",
              "artifact_identity_mismatch",
              "nonfinite",
              "direct_operator_failure",
              "logit_failure",
              "token_mismatch",
              "missing_prefill_fallback_coverage",
              "missing_cached_decode_native_coverage",
              "native_or_fallback_error",
              "call_reconciliation_failure",
              "nonzero_inflight",
              "missing_timing_sample",
              "drift_out_of_bounds",
              "runner_error"
            ]
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "encoding",
        "tokenizer_method",
        "add_special_tokens",
        "input_ids",
        "attention_mask"
      ],
      "properties": {
        "text": {"const": "Write one short sentence about a compiler."},
        "encoding": {"const": "UTF-8"},
        "tokenizer_method": {
          "const": "AutoTokenizer.from_pretrained-local-files-only"
        },
        "add_special_tokens": {"const": true},
        "input_ids": {
          "const": [1, 14350, 697, 3273, 10541, 1048, 263, 6516, 29889]
        },
        "attention_mask": {"const": [1, 1, 1, 1, 1, 1, 1, 1, 1]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkout",
        "model",
        "asset_inventory_identity",
        "rebuild_commands"
      ],
      "properties": {
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "dirty"],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "not": {"const": "0000000000000000000000000000000000000000"}
            },
            "dirty": {"const": false}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "revision", "filename", "bytes", "identity"],
          "properties": {
            "model_id": {"const": "TinyLlama/TinyLlama-1.1B-Chat-v1.0"},
            "revision": {
              "const": "fe8a4ea1ffedaf415f4da2f062534de366a451e6"
            },
            "filename": {"const": "model.safetensors"},
            "bytes": {"const": 2200119864},
            "identity": {
              "const": "sha256:6e6001da2106d4757498752a021df6c2bdc332c650aae4bae6b0c004dcf14933"
            }
          }
        },
        "asset_inventory_identity": {
          "const": "sha256:f659b26572357af84a5e5b66138331a2e35c319c5c9b8300cf81f7ea217ae0de"
        },
        "rebuild_commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prepare_assets", "run_session"],
          "properties": {
            "prepare_assets": {"type": "string", "minLength": 1, "maxLength": 4096},
            "run_session": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software",
        "tokenizer",
        "model",
        "host",
        "runner_process_id",
        "torch_num_threads",
        "torch_num_interop_threads",
        "hf_hub_offline",
        "transformers_offline",
        "local_files_only"
      ],
      "properties": {
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "numpy",
            "torch",
            "transformers",
            "tokenizers",
            "safetensors",
            "rust",
            "clang"
          ],
          "properties": {
            "python": {"const": "3.12.14"},
            "numpy": {"const": "2.4.4"},
            "torch": {"const": "2.13.0"},
            "transformers": {"const": "5.12.1"},
            "tokenizers": {"const": "0.22.2"},
            "safetensors": {"const": "0.6.2"},
            "rust": {"const": "1.98.0"},
            "clang": {
              "const": "Apple clang version 17.0.0 (clang-1700.0.13.5)"
            }
          }
        },
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "is_fast", "method"],
          "properties": {
            "class": {"const": "LlamaTokenizer"},
            "is_fast": {"const": true},
            "method": {"const": "AutoTokenizer.from_pretrained-local-files-only"}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "device", "dtype", "eval_mode"],
          "properties": {
            "class": {"const": "LlamaForCausalLM"},
            "device": {"const": "cpu"},
            "dtype": {"const": "float32"},
            "eval_mode": {"const": true}
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_id",
            "os",
            "os_version",
            "os_build",
            "kernel_release",
            "arch",
            "cpu_model",
            "hardware_model",
            "physical_cores",
            "logical_cores",
            "features",
            "affinity_policy"
          ],
          "properties": {
            "host_id": {"const": "apple-m4-primary"},
            "os": {"const": "macos"},
            "os_version": {"const": "15.5"},
            "os_build": {"const": "24F74"},
            "kernel_release": {"const": "24.5.0"},
            "arch": {"const": "aarch64"},
            "cpu_model": {"const": "Apple M4"},
            "hardware_model": {"const": "Mac16,13"},
            "physical_cores": {"const": 10},
            "logical_cores": {"const": 10},
            "features": {"const": ["neon"]},
            "affinity_policy": {
              "const": "macOS default scheduler; no hard affinity requested"
            }
          }
        },
        "runner_process_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "torch_num_threads": {"const": 1},
        "torch_num_interop_threads": {"const": 1},
        "hf_hub_offline": {"const": true},
        "transformers_offline": {"const": true},
        "local_files_only": {"const": true}
      }
    },
    "asset_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "directory",
        "layer_path",
        "tensor_name",
        "manifest_identity",
        "tensor_identity",
        "logical_weight_identity",
        "packed_weight_identity",
        "packed_bytes",
        "module_identity",
        "fallback_identity",
        "fallback_bytes"
      ],
      "properties": {
        "layer": {"type": "integer", "minimum": 0, "maximum": 21},
        "directory": {"type": "string", "pattern": "^layers/[0-9]{2}$"},
        "layer_path": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj$"
        },
        "tensor_name": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj\\.weight$"
        },
        "manifest_identity": {"$ref": "#/$defs/identity"},
        "tensor_identity": {"$ref": "#/$defs/identity"},
        "logical_weight_identity": {"$ref": "#/$defs/identity"},
        "packed_weight_identity": {"$ref": "#/$defs/identity"},
        "packed_bytes": {"const": 4718592},
        "module_identity": {
          "const": "sha256:564dbd74857d3fe00b25bf4acbe6cf06d6ff47ab603ae9eb1ba3a530edc8ea44"
        },
        "fallback_identity": {"$ref": "#/$defs/identity"},
        "fallback_bytes": {"const": 16777216}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "source",
        "aggregate_identity",
        "layer_count",
        "total_packed_bytes",
        "total_fallback_bytes",
        "entries"
      ],
      "properties": {
        "format": {"const": "decodeforge_q_proj_inventory_v1"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_id", "revision", "filename", "bytes", "identity"],
          "properties": {
            "model_id": {"const": "TinyLlama/TinyLlama-1.1B-Chat-v1.0"},
            "revision": {
              "const": "fe8a4ea1ffedaf415f4da2f062534de366a451e6"
            },
            "filename": {"const": "model.safetensors"},
            "bytes": {"const": 2200119864},
            "identity": {
              "const": "sha256:6e6001da2106d4757498752a021df6c2bdc332c650aae4bae6b0c004dcf14933"
            }
          }
        },
        "aggregate_identity": {
          "const": "sha256:f659b26572357af84a5e5b66138331a2e35c319c5c9b8300cf81f7ea217ae0de"
        },
        "layer_count": {"const": 22},
        "total_packed_bytes": {"const": 103809024},
        "total_fallback_bytes": {"const": 369098752},
        "entries": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {"$ref": "#/$defs/asset_entry"}
        }
      }
    },
    "startup_timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_startup_ns",
        "tokenizer_load_ns",
        "model_load_ns",
        "install_ns",
        "baseline_rss_bytes",
        "peak_rss_bytes"
      ],
      "properties": {
        "cold_startup_ns": {"type": "integer", "minimum": 1},
        "tokenizer_load_ns": {"type": "integer", "minimum": 1},
        "model_load_ns": {"type": "integer", "minimum": 1},
        "install_ns": {"type": "integer", "minimum": 1},
        "baseline_rss_bytes": {"type": "integer", "minimum": 1},
        "peak_rss_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "offline_preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "receipt_identity",
        "elapsed_ns",
        "asset_inventory_identity"
      ],
      "properties": {
        "source": {"const": "separately_captured_prepare_command"},
        "receipt_identity": {"$ref": "#/$defs/identity"},
        "elapsed_ns": {"type": "integer", "minimum": 1},
        "asset_inventory_identity": {
          "const": "sha256:f659b26572357af84a5e5b66138331a2e35c319c5c9b8300cf81f7ea217ae0de"
        }
      }
    },
    "counter_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward",
        "native_attempt",
        "native_success",
        "native_error",
        "fallback_attempt",
        "fallback_success",
        "fallback_error",
        "predispatch_error",
        "rejected_closed",
        "in_flight",
        "closed"
      ],
      "properties": {
        "forward": {"type": "integer", "minimum": 0},
        "native_attempt": {"type": "integer", "minimum": 0},
        "native_success": {"type": "integer", "minimum": 0},
        "native_error": {"type": "integer", "minimum": 0},
        "fallback_attempt": {"type": "integer", "minimum": 0},
        "fallback_success": {"type": "integer", "minimum": 0},
        "fallback_error": {"type": "integer", "minimum": 0},
        "predispatch_error": {"type": "integer", "minimum": 0},
        "rejected_closed": {"type": "integer", "minimum": 0},
        "in_flight": {"type": "integer", "minimum": 0},
        "closed": {"type": "boolean"}
      }
    },
    "counter_delta_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward",
        "native_attempt",
        "native_success",
        "native_error",
        "fallback_attempt",
        "fallback_success",
        "fallback_error",
        "predispatch_error",
        "rejected_closed",
        "in_flight",
        "closed_changed"
      ],
      "properties": {
        "forward": {"type": "integer"},
        "native_attempt": {"type": "integer"},
        "native_success": {"type": "integer"},
        "native_error": {"type": "integer"},
        "fallback_attempt": {"type": "integer"},
        "fallback_success": {"type": "integer"},
        "fallback_error": {"type": "integer"},
        "predispatch_error": {"type": "integer"},
        "rejected_closed": {"type": "integer"},
        "in_flight": {"type": "integer"},
        "closed_changed": {"type": "boolean"}
      }
    },
    "counter_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "layer_path", "values"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0, "maximum": 21},
        "layer_path": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj$"
        },
        "values": {"$ref": "#/$defs/counter_values"}
      }
    },
    "counter_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "layer_path", "values"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0, "maximum": 21},
        "layer_path": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj$"
        },
        "values": {"$ref": "#/$defs/counter_delta_values"}
      }
    },
    "run_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "delta"],
      "properties": {
        "before": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {"$ref": "#/$defs/counter_snapshot"}
        },
        "after": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {"$ref": "#/$defs/counter_snapshot"}
        },
        "delta": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "items": {"$ref": "#/$defs/counter_delta"}
        }
      }
    },
    "step_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_abs", "max_allowed", "max_excess", "pass"],
      "properties": {
        "max_abs": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum elementwise absolute difference."
        },
        "max_allowed": {
          "type": "number",
          "minimum": 0,
          "description": "Allowed error at the element that maximizes max_excess."
        },
        "max_excess": {
          "type": "number",
          "description": "max_i(abs(diff_i) - (atol + rtol * abs(reference_i)))."
        },
        "pass": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_index",
        "token_id",
        "logits_sha256",
        "logit_count",
        "finite",
        "hybrid_comparison"
      ],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "token_id": {"type": "integer", "minimum": 0, "maximum": 31999},
        "logits_sha256": {
          "$ref": "urn:decodeforge:schema:common-v1#/$defs/sha256"
        },
        "logit_count": {"const": 32000},
        "finite": {"type": "boolean"},
        "hybrid_comparison": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/step_comparison"}]
        }
      }
    },
    "q_projection_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "layer", "layer_path", "dispatch", "dispatch_ns"],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0, "maximum": 7},
        "layer": {"type": "integer", "minimum": 0, "maximum": 21},
        "layer_path": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj$"
        },
        "dispatch": {"enum": ["fallback", "native"]},
        "dispatch_ns": {"type": "integer", "minimum": 1}
      }
    },
    "run_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefill_ns",
        "time_to_first_token_ns",
        "cached_step_ns",
        "q_projection_dispatches",
        "q_projection_ns",
        "native_work_ns",
        "native_work_unavailable_reason",
        "total_ns"
      ],
      "properties": {
        "prefill_ns": {"type": "integer", "minimum": 1},
        "time_to_first_token_ns": {"type": "integer", "minimum": 1},
        "cached_step_ns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {"type": "integer", "minimum": 1}
        },
        "q_projection_dispatches": {
          "type": "array",
          "minItems": 44,
          "maxItems": 176,
          "items": {"$ref": "#/$defs/q_projection_dispatch"}
        },
        "q_projection_ns": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "native_work_ns": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "native_work_unavailable_reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "total_ns": {"type": "integer", "minimum": 1}
      }
    },
    "native_output_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "layer_path", "step_index", "result"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0, "maximum": 21},
        "layer_path": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj$"
        },
        "step_index": {"type": "integer", "minimum": 1, "maximum": 7},
        "result": {"$ref": "#/$defs/numeric_result"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "repetition",
        "order_index",
        "path",
        "output_ids",
        "decoded_text",
        "text_role",
        "steps",
        "native_output_checks",
        "timing",
        "counters"
      ],
      "properties": {
        "phase": {"enum": ["warmup", "measured"]},
        "repetition": {"type": "integer", "minimum": 0, "maximum": 9},
        "order_index": {"type": "integer", "minimum": 0, "maximum": 23},
        "path": {"enum": ["same_q8_reference", "hybrid_native"]},
        "output_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"type": "integer", "minimum": 0, "maximum": 31999}
        },
        "decoded_text": {"type": "string", "maxLength": 16384},
        "text_role": {
          "const": "demonstration_only_not_correctness_evidence"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/step"}
        },
        "native_output_checks": {
          "type": "array",
          "maxItems": 154,
          "items": {"$ref": "#/$defs/native_output_check"}
        },
        "timing": {"$ref": "#/$defs/run_timing"},
        "counters": {"$ref": "#/$defs/run_counters"}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {"$ref": "#/$defs/run"}
    },
    "numeric_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_abs", "max_allowed", "max_excess", "finite", "pass"],
      "properties": {
        "max_abs": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum elementwise absolute difference."
        },
        "max_allowed": {
          "type": "number",
          "minimum": 0,
          "description": "Allowed error at the element that maximizes max_excess."
        },
        "max_excess": {
          "type": "number",
          "description": "max_i(abs(diff_i) - (atol + rtol * abs(reference_i)))."
        },
        "finite": {"type": "boolean"},
        "pass": {"type": "boolean"}
      }
    },
    "direct_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "layer_path", "result"],
      "properties": {
        "layer": {"type": "integer", "minimum": 0, "maximum": 21},
        "layer_path": {
          "type": "string",
          "pattern": "^model\\.layers\\.(?:[0-9]|1[0-9]|2[01])\\.self_attn\\.q_proj$"
        },
        "result": {"$ref": "#/$defs/numeric_result"}
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_operator", "model_logits", "tokens", "overall_pass"],
      "properties": {
        "direct_operator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absolute_tolerance",
            "relative_tolerance",
            "preinstallation_layers",
            "native_output_check_count",
            "pass"
          ],
          "properties": {
            "absolute_tolerance": {"const": 0.0001},
            "relative_tolerance": {"const": 0.0001},
            "preinstallation_layers": {
              "type": "array",
              "minItems": 22,
              "maxItems": 22,
              "items": {"$ref": "#/$defs/direct_layer"}
            },
            "native_output_check_count": {
              "type": "integer",
              "minimum": 264,
              "maximum": 1848
            },
            "pass": {"type": "boolean"}
          }
        },
        "model_logits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absolute_tolerance",
            "relative_tolerance",
            "comparison_count",
            "pass"
          ],
          "properties": {
            "absolute_tolerance": {"const": 0.001},
            "relative_tolerance": {"const": 0.001},
            "comparison_count": {"type": "integer", "minimum": 24, "maximum": 96},
            "pass": {"type": "boolean"}
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "comparison_count", "pass"],
          "properties": {
            "policy": {"const": "exact_token_id_match"},
            "comparison_count": {"const": 12},
            "pass": {"type": "boolean"}
          }
        },
        "overall_pass": {"type": "boolean"}
      }
    },
    "path_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "warmup_runs",
        "measured_runs",
        "prefill_calls_per_layer",
        "cached_decode_calls_per_layer",
        "total_calls_per_layer",
        "pass"
      ],
      "properties": {
        "path": {"enum": ["same_q8_reference", "hybrid_native"]},
        "warmup_runs": {"const": 2},
        "measured_runs": {"const": 10},
        "prefill_calls_per_layer": {"const": 12},
        "cached_decode_calls_per_layer": {
          "type": "integer",
          "minimum": 12,
          "maximum": 84
        },
        "total_calls_per_layer": {
          "type": "integer",
          "minimum": 24,
          "maximum": 96
        },
        "pass": {"type": "boolean"}
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post_run_native_validation_counters",
        "installation",
        "paths",
        "pass"
      ],
      "properties": {
        "post_run_native_validation_counters": {
          "$ref": "#/$defs/run_counters"
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installed_modules",
            "restored_modules",
            "live_adapters",
            "in_flight",
            "closed"
          ],
          "properties": {
            "installed_modules": {"const": 22},
            "restored_modules": {"const": 22},
            "live_adapters": {"const": 0},
            "in_flight": {"const": 0},
            "closed": {"const": true}
          }
        },
        "paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/path_reconciliation"}
        },
        "pass": {"type": "boolean"}
      }
    },
    "path_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "first_window_median_ns",
        "last_window_median_ns",
        "ratio",
        "pass"
      ],
      "properties": {
        "path": {"enum": ["same_q8_reference", "hybrid_native"]},
        "first_window_median_ns": {"type": "number", "exclusiveMinimum": 0},
        "last_window_median_ns": {"type": "number", "exclusiveMinimum": 0},
        "ratio": {"type": "number", "exclusiveMinimum": 0},
        "pass": {"type": "boolean"}
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "window_generations",
        "ratio_lower",
        "ratio_upper",
        "paths",
        "pass"
      ],
      "properties": {
        "metric": {
          "const": "ratio_of_last_window_median_to_first_window_median_total_generation_ns_per_path"
        },
        "window_generations": {"const": 3},
        "ratio_lower": {"const": 0.9},
        "ratio_upper": {"const": 1.1},
        "paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/path_drift"}
        },
        "pass": {"type": "boolean"}
      }
    }
  }
}
