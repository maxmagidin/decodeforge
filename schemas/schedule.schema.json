{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decodeforge:schema:schedule-v1",
  "title": "DecodeForge LoopKernelV1 schedule V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shape",
    "variant",
    "vector_axis",
    "vector_lanes",
    "n_tile",
    "k_block",
    "k_unroll",
    "accumulators",
    "reduction_order",
    "arithmetic",
    "k_padding",
    "pack",
    "n_tail",
    "target",
    "numeric_mode"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "variant": { "const": "scalar" } }
      },
      "then": {
        "properties": {
          "vector_lanes": { "const": 1 },
          "target": { "const": { "triple": "portable", "features": [] } }
        }
      }
    },
    {
      "if": {
        "properties": { "variant": { "const": "neon" } }
      },
      "then": {
        "properties": {
          "vector_lanes": { "const": 4 },
          "target": { "const": { "triple": "aarch64-apple-darwin", "features": ["neon"] } }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "$ref": "urn:decodeforge:schema:common-v1#/$defs/schema_version"
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m", "n", "k"],
      "properties": {
        "m": { "type": "integer", "const": 1 },
        "n": { "type": "integer", "minimum": 1, "maximum": 4294967292 },
        "k": { "type": "integer", "minimum": 1, "maximum": 4294967264 }
      }
    },
    "variant": {
      "type": "string",
      "enum": ["scalar", "neon"]
    },
    "vector_axis": {
      "type": "string",
      "const": "output"
    },
    "vector_lanes": {
      "type": "integer",
      "enum": [
        1,
        4
      ]
    },
    "n_tile": {
      "type": "integer",
      "const": 4
    },
    "k_block": {
      "type": "integer",
      "const": 32
    },
    "k_unroll": {
      "type": "integer",
      "const": 1
    },
    "accumulators": {
      "type": "integer",
      "const": 1
    },
    "reduction_order": {
      "type": "string",
      "const": "ascending-block-lane"
    },
    "arithmetic": {
      "type": "string",
      "const": "separate-mul-add"
    },
    "k_padding": {
      "type": "string",
      "const": "logical-only"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "alignment"
      ],
      "properties": {
        "layout": {
          "type": "string",
          "const": "output-interleaved"
        },
        "alignment": {
          "type": "integer",
          "const": 16
        }
      }
    },
    "n_tail": {
      "type": "string",
      "const": "scalar-cleanup"
    },
    "prefetch_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 65535
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triple", "features"],
      "properties": {
        "triple": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "numeric_mode": {
      "$ref": "urn:decodeforge:schema:common-v1#/$defs/numeric_mode"
    }
  }
}
